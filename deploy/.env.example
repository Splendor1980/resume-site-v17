# Пример переменных окружения для deploy/deploy-yandex.sh
# Скопируй в .env (или экспортируй в шелле) и впиши свои значения.

# Имя бакета Yandex Cloud Object Storage
YC_BUCKET=resume-site-bucket

# Идентификатор каталога (из yc init / консоли)
YC_FOLDER_ID=

# Статический ключ доступа (сервисный аккаунт с ролью editor/storage.editor).
# Создаётся в консоли: Сервисные аккаунты → СА → Создать ключ → «Статический ключ доступа»,
# либо через yc: yc iam access-key create --service-account-name <sa>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Эндпоинт S3-совместимого API Yandex (менять не нужно)
S3_ENDPOINT=https://storage.yandexcloud.net