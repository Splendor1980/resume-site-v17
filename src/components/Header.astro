---
const showLinks = Astro.props.showLinks ?? true;
const dark = Astro.props.dark ?? false;
---
<header class:list={['site-header']}>
  <nav class="site-nav">
    <a class="site-brand" href="/">
      <span class="logo-mark">📄</span>
      Резюме без опыта
    </a>
    {showLinks && (
      <div class="site-nav-links">
        <a href="/#idei">Идеи для резюме</a>
        <a href="/idei/">Все 103 идеи</a>
        <a class:list={['cta-btn', { dark }]} href="/konstruktor/"> Собрать резюме →</a>
      </div>
    )}
  </nav>
</header>