<script>
/* ---------- ЗАГРУЗКА ПОЛНОЙ БАЗЫ ---------- */
let items = [];

async function loadData(){
  try{
    const res = await fetch('/data/ideas.json');
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const json = await res.json();
    items = json.items || [];
    if(items.length === 0) throw new Error('Пустая база');
  } catch(e){
    console.error('Не удалось загрузить /data/ideas.json:', e);
    document.getElementById('dataWarning').classList.add('show');
    items = [
      {id:"fallback_1", category:"Игры и техника", tags:["игры"], skills:["логическое мышление","терпение"], roles:["Помощник в магазине электроники"], comment:"пример из аварийного набора — основная база не загрузилась"}
    ];
  }
  initAll();
}

/* ---------- ПОИСК: стемминг + словарь синонимов/жаргона ---------- */
function stem(w){
  w = w.toLowerCase();
  if(w.length <= 4) return w;
  return w.replace(/(иями|ями|ами|скими|ского|ской|ские|ский|ская|ское|его|ому|ыми|ими|ует|ешь|ете|ают|ют|ла|ло|ли|тся|ться|а|я|ы|и|о|е|у|ю|й|ь)$/, '');
}
function tokenize(text){
  return (text || '').toLowerCase().replace(/[^а-яёa-z0-9\s]/g, ' ').split(/\s+/).filter(w => w.length > 2).map(stem);
}
function itemSearchTokens(item){
  if(item._stemTokens) return item._stemTokens;
  const raw = [item.category, ...(item.tags||[]), ...(item.skills||[]), ...(item.examples_now||[])].join(' ');
  item._stemTokens = tokenize(raw);
  return item._stemTokens;
}
/* лёгкое расширение "этапа 2": жаргон/сленг/бренды → тег, без ручной разметки всех 103 записей */
const SYNONYMS = {
  "катка":"игры","тиммейт":"игры","дота":"игры","dota":"игры","кс":"игры","cs":"игры","валорант":"игры",
  "шутер":"игры","майнкрафт":"игры","minecraft":"игры","роблокс":"игры","roblox":"игры",
  "стрим":"видео","стример":"видео","твич":"видео","twitch":"видео","ютуб":"видео","youtube":"видео","блогер":"видео","монтирую":"видео",
  "аниме":"аниме","манга":"аниме","косплей":"творчество",
  "кодить":"it","код":"it","программирую":"it","программа":"it","сайт":"it","github":"it",
  "тренировка":"спорт","качалка":"спорт","зал":"спорт","бег":"спорт","бегаю":"спорт",
  "рисование":"творчество","рисую":"творчество","арт":"творчество",
  "готовлю":"готовка","кулинария":"готовка","печь":"готовка","пеку":"готовка",
  "питомец":"животные","кот":"животные","собака":"животные","кошка":"животные",
  "путешествия":"путешествия","поездки":"путешествия",
  "деньги":"финансы","инвестиции":"финансы","акции":"финансы","крипта":"финансы",
  "английский":"языки","немецкий":"языки","иностранный":"языки",
  "дрон":"техника","квадрокоптер":"техника","fpv":"техника"
};
function matchItems(text, limit){
  const lower = (text||'').toLowerCase();
  const queryTokens = new Set(tokenize(text));
  const bonusTags = new Set();
  Object.keys(SYNONYMS).forEach(k=>{ if(lower.includes(k)) bonusTags.add(SYNONYMS[k]); });
  if(queryTokens.size===0 && bonusTags.size===0) return [];
  const scored = items.map(item=>{
    const hay = itemSearchTokens(item);
    let score = 0;
    hay.forEach(t=>{ if(queryTokens.has(t)) score++; });
    (item.tags||[]).forEach(tag=>{
      if(queryTokens.has(stem(tag))) score += 2;
      if(bonusTags.has(tag)) score += 3;
    });
    return {item, score};
  }).filter(x=>x.score>0).sort((a,b)=>b.score-a.score);
  return scored.slice(0, limit || 3).map(x=>x.item);
}

/* ---------- DOM refs ---------- */
const filtersEl = document.getElementById('filters');
const boardEl = document.getElementById('board');
const roleGridEl = document.getElementById('roleGrid');
const roleResultEl = document.getElementById('roleResult');
const roleSearchEl = document.getElementById('roleSearch');
const roleChosenEl = document.getElementById('roleChosen');
const sheetContainer = document.getElementById('sheetContainer');
const counterEl = document.getElementById('counter');
const ctaLock = document.getElementById('ctaLock');
const headerTitle = document.getElementById('headerTitle');
const headerSub = document.getElementById('headerSub');
const browseSection = document.getElementById('browseSection');
const byRoleSection = document.getElementById('byRoleSection');
const aiSection = document.getElementById('aiSection');
const chatLog = document.getElementById('chatLog');
const chatInput = document.getElementById('chatInput');
const chatSend = document.getElementById('chatSend');
const quickReplies = document.getElementById('quickReplies');
const recBox = document.getElementById('recBox');
const dontKnowBtn = document.getElementById('dontKnowBtn');
const branchPanel = document.getElementById('branchPanel');
const gearBtn = document.getElementById('gearBtn');
const drawerOverlay = document.getElementById('drawerOverlay');
const drawerClose = document.getElementById('drawerClose');

let active = new Set();
let added = [];
let activeRole = null;
let haveSkills = new Set();
/* ручные поля резюме — живут отдельно от added, переживают перерисовку шаблона */
let profile = { name:'', role:'', phone:'', email:'', education:'', about:'', aboutTouched:false, exp:'', expTouched:false, schedule:'', portfolio:'' };

/* ---------- DRAWER ---------- */
gearBtn.addEventListener('click', ()=> drawerOverlay.classList.add('open'));
drawerClose.addEventListener('click', ()=> drawerOverlay.classList.remove('open'));
drawerOverlay.addEventListener('click', (e)=>{ if(e.target===drawerOverlay) drawerOverlay.classList.remove('open'); });

/* ---------- MODE SWITCH ---------- */
document.querySelectorAll('.mode-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const mode = btn.dataset.mode;
    browseSection.style.display = mode==='browse' ? 'block' : 'none';
    byRoleSection.style.display = mode==='byrole' ? 'block' : 'none';
    aiSection.style.display = mode==='ai' ? 'block' : 'none';
    if(mode==='browse'){
      headerTitle.textContent = 'Листай и нажимай «Добавить в резюме»';
      headerSub.textContent = 'Резюме слева заполняется само. Ничего не нужно печатать вручную.';
    } else if(mode==='byrole'){
      headerTitle.textContent = 'Выбери профессию — узнай, что для неё уже умеешь';
      headerSub.textContent = 'Обратный способ: не от хобби к роли, а от роли к скрытым навыкам.';
    } else {
      headerTitle.textContent = 'Расскажи, чем занимаешься — подскажем, что с этим делать';
      headerSub.textContent = 'Работает по нашей базе идей локально, без внешнего ИИ.';
      if(!chatStarted) startChat();
    }
  });
});

/* ---------- ОБЩИЙ TOGGLE: добавить/убрать идею из резюме ---------- */
function toggleAdded(itemId){
  const idx = added.findIndex(a=>a.id===itemId);
  if(idx>=0){ added.splice(idx,1); }
  else { const item = items.find(i=>i.id===itemId); if(item) added.push(item); }
  updateResume();
}

/* ---------- MODE A: BROWSE ---------- */
function renderFilters(){
  const allTags = [...new Set(items.flatMap(i=>i.tags||[]))].sort();
  filtersEl.innerHTML = allTags.map(t=>`<button class="chip${active.has(t)?' active':''}" data-tag="${t}">${t}</button>`).join('');
  filtersEl.querySelectorAll('.chip').forEach(chip=>{
    chip.addEventListener('click',()=>{
      const t = chip.dataset.tag;
      active.has(t)?active.delete(t):active.add(t);
      renderFilters(); renderBoard();
    });
  });
}

function researchBlockHtml(item){
  if(!item.research) return '';
  return `<button class="research-toggle" data-research-id="${item.id}">🔬 Что говорят исследования</button>
    <div class="research-box" id="research-${item.id}">
      <div class="rb-summary">${item.research.summary}</div>
      <div class="rb-caveat">⚠️ ${item.research.caveat}</div>
      <div class="rb-source">Источник: <a href="${item.research.source_url}" target="_blank" rel="noopener">${item.research.source_name}</a></div>
    </div>`;
}

function renderBoard(){
  const filtered = active.size===0 ? items : items.filter(i=>(i.tags||[]).some(t=>active.has(t)));
  if(filtered.length===0){ boardEl.innerHTML = `<div class="empty-state">Ничего не нашлось по этим тегам.</div>`; return; }
  boardEl.innerHTML = filtered.map(item=>{
    const isAdded = added.find(a=>a.id===item.id);
    return `<div class="card">
      <div class="card-top">
        <span class="card-eyebrow">${item.category}</span>
        ${(item.examples_now || []).length ? `<div class="card-exam">${item.examples_now.map(e=>`<span class="ex">${e}</span>`).join('')}</div>` : ''}
      </div>
      <h3><a href="/idei/${item.id}/">${item.activity_title || item.category}</a></h3>
      ${item.comment ? `<p class="card-comment">${item.comment}</p>` : ''}
      ${(item.roles||[]).length ? `<p class="card-roles"><b>Подойдёт для:</b> ${item.roles.slice(0,3).join(' · ')}</p>` : ''}
      ${researchBlockHtml(item)}
      <button class="add-btn${isAdded?' added':''}" data-id="${item.id}">${isAdded?'✓ Добавлено (нажми, чтобы убрать)':'+ Добавить в резюме'}</button>
    </div>`;
  }).join('');

  boardEl.querySelectorAll('.add-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      toggleAdded(btn.dataset.id);
      renderBoard();
      renderRoleResult();
    });
  });
  boardEl.querySelectorAll('.research-toggle').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.getElementById('research-' + btn.dataset.researchId).classList.toggle('open');
    });
  });
}

/* ---------- MODE B: BY ROLE ---------- */
let roleSearchQuery = '';

function renderRoleGrid(){
  const allRoles = [...new Set(items.flatMap(i=>i.roles||[]))].sort();

  // если профессия уже выбрана — сворачиваем плитку, показываем только маленький чип
  if(activeRole){
    roleGridEl.style.display = 'none';
    roleSearchEl.style.display = 'none';
    roleChosenEl.style.display = 'block';
    roleChosenEl.innerHTML = `<div class="role-chosen-chip">${activeRole} <button id="changeRoleBtn">изменить</button></div>`;
    document.getElementById('changeRoleBtn').addEventListener('click', ()=>{
      activeRole = null;
      roleSearchQuery = '';
      roleSearchEl.value = '';
      renderRoleGrid();
      renderRoleResult();
    });
    return;
  }

  roleGridEl.style.display = 'flex';
  roleSearchEl.style.display = 'block';
  roleChosenEl.style.display = 'none';

  const q = roleSearchQuery.toLowerCase();
  const filtered = q ? allRoles.filter(r=>r.toLowerCase().includes(q)) : allRoles;

  if(filtered.length===0){
    roleGridEl.innerHTML = `<div class="empty-state">Ничего не нашлось — попробуй другое слово.</div>`;
    return;
  }
  roleGridEl.innerHTML = filtered.map(r=>`<button class="role-chip" data-role="${r}">${r}</button>`).join('');
  roleGridEl.querySelectorAll('.role-chip').forEach(chip=>{
    chip.addEventListener('click',()=>{
      activeRole = chip.dataset.role;
      renderRoleGrid();
      renderRoleResult();
    });
  });
}

roleSearchEl.addEventListener('input', ()=>{
  roleSearchQuery = roleSearchEl.value;
  renderRoleGrid();
});

function renderRoleResult(){
  if(!activeRole){ roleResultEl.innerHTML = `<div class="empty-state">Здесь появятся навыки, как только выберешь профессию.</div>`; return; }
  const matching = items.filter(i=>(i.roles||[]).includes(activeRole));
  if(matching.length===0){ roleResultEl.innerHTML = `<div class="empty-state">Пока нет связок для этой роли.</div>`; return; }

  const skillMap = new Map();
  matching.forEach(item=>{
    const reframed = (item.skills_reframed && item.skills_reframed.length) ? item.skills_reframed : (item.skills||[]);
    reframed.forEach(s=>{ if(!skillMap.has(s)) skillMap.set(s, item); });
  });

  roleResultEl.innerHTML = [...skillMap.entries()].map(([skill,srcItem])=>{
    const isHave = haveSkills.has(skill);
    return `<div class="skill-check${isHave?' have':''}" data-skill="${skill}" data-item="${srcItem.id}">
      <div class="box">${isHave?'✓':''}</div>
      <div class="txt">
        <div class="sk">${skill}</div>
        <div class="src">Обычно есть у тех, кто увлекается: ${srcItem.category.toLowerCase()}</div>
        ${srcItem.employer_value ? `<div class="src" style="margin-top:3px;">💼 ${srcItem.employer_value}</div>` : ''}
      </div>
    </div>`;
  }).join('');

  roleResultEl.querySelectorAll('.skill-check').forEach(el=>{
    el.addEventListener('click',()=>{
      const skill = el.dataset.skill;
      const srcItem = items.find(i=>i.id===el.dataset.item);
      if(haveSkills.has(skill)){
        haveSkills.delete(skill);
        const stillNeeded = [...skillMap.entries()].some(([s,it])=> it.id===srcItem.id && haveSkills.has(s));
        if(!stillNeeded){ const idx = added.findIndex(a=>a.id===srcItem.id); if(idx>=0) added.splice(idx,1); }
      } else {
        haveSkills.add(skill);
        if(!added.find(a=>a.id===srcItem.id)) added.push(srcItem);
      }
      updateResume();
      renderRoleResult();
    });
  });
}

/* ---------- RESUME: адаптивный + редактируемый шаблон ---------- */
function aboutTextFrom(list){
  /* Новая версия (v4 базы): используем about_snippet, подготовленный по методологии
     Ramit Sethi / Laszlo Bock / Ильяхов — вместо алгоритмической формулы "Умею: X.
     Наработал(а) через: Y". Формула была нашей временной заплаткой; теперь у каждой
     карточки есть осмысленно написанная фраза. Собираем 2-3 сниппета в связный абзац. */
  const snippets = list.map(a => a.about_snippet).filter(Boolean).slice(0,3);
  if(snippets.length === 0){
    // fallback на случай если у записи почему-то нет about_snippet (не должно происходить в v4)
    return 'Умею: ' + [...new Set(list.flatMap(a=>a.skills||[]))].slice(0,3).join(', ') + '.';
  }
  return snippets.join('\n');
}
function expLineFrom(item){
  return item.resume_bullet || `${(item.skills||[]).join(', ')} — практика: ${item.category}.`;
}
function expTextFrom(list){
  return list.map(expLineFrom).join('\n');
}
function bindProfileInputs(container){
  container.querySelectorAll('[data-profile-field]').forEach(inp=>{
    inp.addEventListener('input', ()=>{ profile[inp.dataset.profileField] = inp.value; });
  });
  container.querySelectorAll('[data-profile-textarea]').forEach(ta=>{
    ta.addEventListener('input', ()=>{
      const field = ta.dataset.profileTextarea;
      profile[field] = ta.value;
      profile[field + 'Touched'] = true;
    });
  });
  container.querySelectorAll('[data-reset-field]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const field = btn.dataset.resetField;
      profile[field] = '';
      profile[field + 'Touched'] = false;
      updateResume();
    });
  });
}
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function escAttr(s){ return esc(s).replace(/\n/g,'&#10;'); }

function editableBlock(label, field, autoText, rows){
  const touched = profile[field + 'Touched'];
  const value = touched ? profile[field] : autoText;
  const resetBtn = touched ? `<button class="reset-btn" data-reset-field="${field}">↺ вернуть автотекст</button>` : '';
  // Блюр/readonly до разблокировки убраны по решению: защита от копирования технически
  // слабая и вредная (мешает ATS, не даёт исправить ошибки, создаёт "кота в мешке" —
  // пользователь не видит, что получает, пока не выполнит условие). Копирование — на
  // совести пользователя, кнопка "Скачать PDF" остаётся единственной точкой разблокировки.
  return `<div class="editable-wrap">
    <div class="field-head"><div class="label-sm" style="margin-bottom:0;">${label}</div>${resetBtn}</div>
    <textarea class="field-textarea" data-profile-textarea="${field}" rows="${rows}" placeholder="Впиши или дополни текст">${esc(value)}</textarea>
  </div>`;
}

