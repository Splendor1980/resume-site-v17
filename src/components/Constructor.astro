function renderTraitSynthesis(){
  const box = document.getElementById('traitBox');
  if(!box) return;
  if(added.length < 2){ box.style.display = 'none'; box.innerHTML=''; return; }

  const tagSet = new Set(added.flatMap(a=>a.tags||[]));
  const matched = [];
  TRAIT_RULES.forEach(rule=>{
    if(rule.tags.every(t=>tagSet.has(t)) && !matched.find(m=>m.trait===rule.trait)) matched.push(rule);
  });

  box.style.display = 'block';
  if(matched.length===0){
    box.innerHTML = `<div class="trait-card"><div class="trait-label">✦ Что вырисовывается</div><div class="trait-text">Пока рано делать выводы, но уже видно, что интересы у тебя разносторонние — само по себе неплохая черта.</div></div>`;
    return;
  }
  box.innerHTML = matched.slice(0,2).map(rule=>{
    const phrase = rule.phrases[Math.floor(Math.random()*rule.phrases.length)];
    return `<div class="trait-card"><div class="trait-label">✦ ${rule.trait}</div><div class="trait-text">${phrase}</div></div>`;
  }).join('');
}

/* ---------- MODE C: ПОДСКАЗЧИК (локальный, без внешнего ИИ) ---------- */
let chatStarted = false;
let chatStep = 0;

function addMsg(text, who){
  const m = document.createElement('div');
  m.className = 'msg ' + who;
  m.textContent = text;
  chatLog.appendChild(m);
  chatLog.scrollTop = chatLog.scrollHeight;
}

function startChat(){
  chatStarted = true;
  addMsg('Привет! 👋 Я помогу придумать, что написать в резюме. Расскажи — чем ты обычно занимаешься в свободное время: игры, сериалы, спорт, что мастеришь руками. Что угодно!', 'bot');
  quickReplies.innerHTML = ['Играю в игры','Смотрю сериалы','Занимаюсь спортом','Что-то мастерю руками'].map(q=>`<span class="quick-reply">${q}</span>`).join('');
  bindQuickReplies();
  chatStep = 1;
}
function bindQuickReplies(){
  quickReplies.querySelectorAll('.quick-reply').forEach(el=>{ el.addEventListener('click', ()=> handleUserMessage(el.textContent)); });
}
function handleUserMessage(text){
  if(!text.trim()) return;
  addMsg(text, 'user');
  chatInput.value = '';
  quickReplies.innerHTML = '';
  branchPanel.style.display = 'none';

  setTimeout(()=>{
    const greeting = /^(прив(eт|етик)?|здравств(уй|уйте)|здорово|добрый день|добрый вечер|доброе утро|hello|hi|хай)[\s!.,?]*$/i.test(text.trim());
    if(greeting){
      addMsg('Привет! 👋 Рад видеть. Расскажи, чем ты обычно занимаешься в свободное время — игры, сериалы, спорт, что мастеришь руками? А я подскажу, что из этого можно написать в резюме.', 'bot');
      chatStep = 2;
      return;
    }
    if(chatStep === 1){
      const found = matchItems(text, 3);
      if(found.length > 0){
        addMsg('Класс, смотри что нашлось по твоим словам — может, что-то откликнется:', 'bot');
        renderRecommendations(found);
        chatStep = 3;
      } else {
        addMsg('Понял. А можешь чуть конкретнее — во что именно играешь, что смотришь или чем занимаешься руками? Любая деталь поможет.', 'bot');
        chatStep = 2;
      }
    } else if(chatStep === 2 || chatStep === 3){
      const found = matchItems(text, 3);
      if(found.length > 0){
        addMsg('Смотри, что нашлось по нашей базе — может, что-то откликнется:', 'bot');
        renderRecommendations(found);
      } else {
        addMsg('Пока не нашёл точного совпадения в базе по этим словам. Попробуй описать иначе, или нажми кнопку ниже — покажу по темам.', 'bot');
      }
      chatStep = 3;
    } else {
      addMsg('Если что-то из рекомендаций подошло — жми «Добавить в резюме». Можем продолжить, если хочешь копнуть ещё одну тему.', 'bot');
    }
  }, 400);
}

dontKnowBtn.addEventListener('click', ()=>{
  if(!chatStarted) startChat();
  const allTags = [...new Set(items.flatMap(i=>i.tags||[]))].sort();
  branchPanel.style.display = 'block';
  branchPanel.innerHTML = `<div class="branch-hint">Выбери тему, которая ближе всего — покажу связанные идеи:</div><div class="branch-chips" id="branchChips">${allTags.map(t=>`<button class="chip" data-branch-tag="${t}">${t}</button>`).join('')}</div>`;
  branchPanel.querySelectorAll('[data-branch-tag]').forEach(chip=>{
    chip.addEventListener('click', ()=>{
      const tag = chip.dataset.branchTag;
      const matching = items.filter(i=>(i.tags||[]).includes(tag)).slice(0,4);
      addMsg('Тема: ' + tag, 'user');
      if(matching.length>0){ addMsg('Вот что обычно встречается в этой теме:', 'bot'); renderRecommendations(matching); }
      else { addMsg('По этой теме пока пусто в базе.', 'bot'); }
