        <div class="contact-row">📞 <input class="field-input small-input" data-profile-field="phone" placeholder="+7 900 000-00-00" value="${esc(profile.phone)}"></div>
      </div>
      <div><div class="label-sm">Навыки</div>${skills.length ? skills.slice(0,4).map((s,i)=>`<div class="skill-bar-item">${s}<div class="bar"><span style="width:${75+((i*7)%20)}%"></span></div></div>`).join('') : '<span class="placeholder">появятся после выбора идей</span>'}</div>
      <div><div class="label-sm">Интересы</div>${tags.length ? tags.map(t=>`<span class="pill">${t}</span>`).join('') : '<span class="placeholder">пока пусто</span>'}</div>
      <div><div class="label-sm">Желаемый график</div><textarea class="field-textarea" data-profile-field="schedule" rows="2" placeholder="Напр.: летом, 20-25 часов в неделю">${esc(profile.schedule)}</textarea></div>
