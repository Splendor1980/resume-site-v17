      ${added.length ? editableBlock('Что предлагаю', 'exp', expTextFrom(added), 4) : '<div><div class="label-sm">Что предлагаю</div><span class="placeholder">выбери идею слева</span></div>'}
      <div><div class="label-sm">Образование</div><textarea class="field-textarea" data-profile-field="education" rows="2" placeholder="Школа / колледж / вуз, год">${esc(profile.education)}</textarea></div>
      <div><div class="label-sm">Портфолио / ссылки <span style="text-transform:none; font-style:italic;">(если есть)</span></div><textarea class="field-textarea" data-profile-field="portfolio" rows="2" placeholder="Instagram, YouTube, GitHub...">${esc(profile.portfolio)}</textarea></div>
      <div class="footnote">Мало контента — компенсируем сайдбаром и воздухом</div>
