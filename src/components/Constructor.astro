/* ---------- ПЕЧАТЬ / PDF: собираем чистый слой без полей ввода и интерфейса ---------- */
function renderPrintSheet(){
  const printEl = document.getElementById('printSheet');
  const skills = [...new Set(added.flatMap(a=>a.skills||[]))];
  const autoRole = added.length ? (added[0].roles||[])[0] : '';
  const roleVal = profile.role || autoRole;
  const aboutVal = profile.aboutTouched ? profile.about : (added.length ? aboutTextFrom(added) : '');
  const contacts = [profile.email, profile.phone].filter(Boolean).join('  ·  ');

  // "Проектный опыт": если пользователь не трогал поле руками — рендерим каждый пункт
  // ОТДЕЛЬНЫМ блоком с запретом разрыва внутри (иначе браузер может разорвать пункт
  // посередине предложения на границе страниц). Если поле отредактировано вручную —
  // это уже свободный текст, структуру по пунктам сохранить нечем, печатаем как есть.
  let expHtml = '';
  if(profile.expTouched){
    if(profile.exp) expHtml = `<div class="p-section"><div class="p-label">Проектный опыт</div><div class="p-text">${esc(profile.exp)}</div></div>`;
  } else if(added.length){
    const items = added.map(a=>`<div class="p-proj"><b>${esc(a.activity_title || a.category)}</b> — ${esc(a.resume_bullet || (a.skills||[]).join(', '))}</div>`).join('');
    expHtml = `<div class="p-section"><div class="p-label">Проектный опыт</div>${items}</div>`;
  }

  printEl.innerHTML = `
    <div class="p-name">${esc(profile.name) || 'Имя Фамилия'}</div>
    ${roleVal ? `<div class="p-role">${esc(roleVal)}</div>` : ''}
    ${contacts ? `<div class="p-contacts">${contacts}</div>` : ''}
    ${profile.schedule ? `<div class="p-section"><div class="p-label">Желаемый график</div><div class="p-text">${esc(profile.schedule)}</div></div>` : ''}
    ${aboutVal ? `<div class="p-section"><div class="p-label">О себе</div><div class="p-text">${esc(aboutVal)}</div></div>` : ''}
    ${skills.length ? `<div class="p-section"><div class="p-label">Навыки</div><div class="p-text p-tags">${skills.map(s=>`<span>· ${s}</span>`).join('')}</div></div>` : ''}
    ${expHtml}
    ${profile.education ? `<div class="p-section"><div class="p-label">Образование</div><div class="p-text">${esc(profile.education)}</div></div>` : ''}
    ${profile.portfolio ? `<div class="p-section"><div class="p-label">Портфолио / ссылки</div><div class="p-text">${esc(profile.portfolio)}</div></div>` : ''}
  `;
}
window.addEventListener('beforeprint', ()=>{
  // Кнопка на сайте — не единственный способ вызвать печать (Ctrl+P/меню браузера её не видят).
  // Поэтому проверяем условие здесь же, при самом событии печати, а не только в клике по кнопке —
  // иначе через Ctrl+P можно получить полное резюме в обход разблокировки.
  if(isUnlocked()){
    renderPrintSheet();
  } else {
    document.getElementById('printSheet').innerHTML = `
      <div style="padding:50mm 25mm; text-align:center; font-family:'Manrope',sans-serif;">
        <div style="font-size:16pt; font-weight:700; margin-bottom:8mm;">Скачивание пока не разблокировано</div>
        <div style="font-size:12pt; line-height:1.6; color:#4A5A4E;">Вернись на сайт, добавь минимум 2 идеи в резюме и нажми «Скачать PDF» — там есть варианты: поделиться постом или просто подождать. Выбирай, что удобнее.</div>
      </div>`;
  }
  bonusBubble.classList.remove('open');
});
window.addEventListener('afterprint', ()=>{
  if(isUnlocked()) bonusBubble.classList.add('open');
});
ctaLock.addEventListener('click', ()=>{
