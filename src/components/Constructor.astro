});

function renderRecommendations(found){
  recBox.innerHTML = found.map(item=>{
    const isAdded = added.find(a=>a.id===item.id);
    return `<div class="rec-card">
      <div class="sk">${item.category}</div>
      <div class="why">${item.comment} → ${(item.roles||[])[0]||''}</div>
      <button class="add-btn${isAdded?' added':''}" data-id="${item.id}" style="width:auto; padding:8px 14px;">${isAdded?'✓ Добавлено (убрать)':'+ Добавить в резюме'}</button>
    </div>`;
  }).join('');
  recBox.querySelectorAll('.add-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      toggleAdded(btn.dataset.id);
      renderRecommendations(found);
    });
  });
}

