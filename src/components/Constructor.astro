});

/* ---------- РАЗБЛОКИРОВКА: поделиться (сразу) или подождать 10 минут — простая версия для пробного запуска ---------- */
const UNLOCK_KEY = 'resumeSiteUnlockedAt';       // timestamp — нужен для 24-часового срока действия
const ACCESS_DURATION_MS = 24 * 60 * 60 * 1000;   // доступ действует 24 часа
const WAIT_MS = 10 * 60 * 1000;                   // бесплатное ожидание — 10 минут
const WAIT_START_KEY = 'resumeSiteWaitStart';

const SITE_URL = 'https://resumegenerator.ru';

const POST_VARIANTS = [
  "90% резюме школьников и студентов начинаются одинаково: «Опыта работы не имею». А ведь опыт чаще всего есть — просто прячется не в трудовой книжке, а в кружке робототехники, в шахматном клубе или в паблике на 800 подписчиков, который ты ведёшь два года. Этот сайт помогает такое увидеть и грамотно написать — бесплатно, за пару минут.\n" + SITE_URL,
  "Работодателю не нужен твой опыт. Ему нужны доказательства, что ты умеешь делать дело — а они чаще всего прячутся не в трудовой книжке, а в том, чем ты увлекаешься по вечерам. Если знаешь кого-то, кто сейчас смотрит на пустое резюме и не понимает, что туда писать — кинь ему эту ссылку.\n" + SITE_URL,
  "Резюме без опыта — не оксюморон. Это просто резюме, которое пока никто не помог написать правильно. Помогли — вот тут, бесплатно.\n" + SITE_URL
];

function isUnlocked(){
  try{
    const unlockedAt = parseInt(localStorage.getItem(UNLOCK_KEY) || '0', 10);
    if(!unlockedAt) return false;
    return (Date.now() - unlockedAt) < ACCESS_DURATION_MS;
  } catch(e){ return false; }
}
function setUnlocked(){
  try{ localStorage.setItem(UNLOCK_KEY, String(Date.now())); } catch(e){}
}

