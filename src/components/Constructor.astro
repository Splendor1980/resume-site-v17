function updateResume(){
  counterEl.textContent = `Добавлено идей: ${added.length}`;
  const isCompact = added.length < 2;
  sheetContainer.className = 'sheet ' + (isCompact ? 'compact' : 'dense');
  sheetContainer.innerHTML = isCompact ? renderCompactSheet() : renderDenseSheet();
  bindProfileInputs(sheetContainer);
  ctaLock.classList.toggle('ready', added.length>=2);
  renderTraitSynthesis();
}

