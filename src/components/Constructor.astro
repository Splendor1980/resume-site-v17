---
// Интерактивный конструктор резюме — «остров», перенесённый из прототипа index.html
// почти без изменений (CSS, разметка и логика сохранены). Изменения по сравнению с
// прототипом: fetch и ссылки на черновики сделаны абсолютными (страница живёт на /konstruktor/).
// Почему не переписан на фреймворк: логика отлажена и проверена Playwright-тестами,
// полностью переносить её в React/Vue было бы большим риском ради нулевой пользы.
---

<style is:global>
  :root{
    --bg: #EEF2E7; --ink: #1E2B22; --ink-soft: #4A5A4E;
    --coral: #FF6B54; --coral-deep: #E4523C;
    --paper1: #FFF8EC; --paper2: #FFEFE4; --paper3: #EAF3F6;
    --line: rgba(30,43,34,0.14); --white: #FFFFFF;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Manrope',sans-serif;-webkit-font-smoothing:antialiased;}

  /* резюме-колонка увеличена ~в 1.6 раза (было minmax(240,300)) */
  .layout{display:grid; grid-template-columns: minmax(320px, min(34vw, 560px)) 1fr; min-height:100vh;}
  @media (max-width:760px){
    .layout{grid-template-columns:1fr;}
    .resume-pane{order:2; position:static; max-height:none;}
    .board-pane{order:1;}
  }

  .data-warning{display:none; background:#FFEDEA; border-bottom:1px solid #F3B9AE; color:#8C3225; font-size:13px; padding:10px 20px; text-align:center;}
  .data-warning.show{display:block;}

  /* LEFT: RESUME */
  .resume-pane{background:linear-gradient(180deg,#E2E9D8,#D8E1CB); position:sticky; top:0; max-height:100vh; border-right:1px solid var(--line); display:flex; flex-direction:column;}
  .resume-scroll{flex:1 1 auto; min-height:0; overflow-y:auto; padding:26px 20px 16px;}
  .resume-footer{flex-shrink:0; padding:14px 20px 22px; border-top:1px solid rgba(30,43,34,0.18); background:rgba(216,225,203,0.6); backdrop-filter:blur(2px);}
  .resume-pane .label{font-family:'Space Mono',monospace; font-size:11.5px; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-soft); margin-bottom:10px;}
  .sheet{background:var(--white); border-radius:6px; box-shadow:0 14px 34px -18px rgba(30,43,34,0.45); min-height:560px; overflow:hidden;}
  .sheet .placeholder{color:#B7BFB2; font-style:italic;}
  .label-sm{font-size:10.5px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.05em; margin-bottom:7px;}

  /* поля ручного ввода прямо в резюме */
  .field-input{border:none; border-bottom:1px dashed var(--line); background:transparent; font-family:inherit; color:inherit; width:100%; padding:2px 0 4px; }
  .field-input:focus{outline:none; border-bottom-color:var(--coral-deep); border-bottom-style:solid;}
  .field-input::placeholder{color:#B7BFB2; font-style:italic; font-weight:400;}
  .name-input{font-family:'Baloo 2',sans-serif; font-weight:800; font-size:19px;}
  .role-input{font-size:13.5px; color:var(--coral-deep); font-weight:700; margin-top:4px;}
  .small-input{font-size:12px; color:var(--ink-soft);}

  .sheet.compact{display:flex; padding:0;}
  .sheet.compact .side{width:42%; background:var(--paper1); padding:20px 16px; display:flex; flex-direction:column; gap:18px; border-right:1px solid var(--line);}
  .sheet.compact .main{flex:1; padding:20px 18px; display:flex; flex-direction:column; gap:18px;}
  .avatar{width:44px;height:44px;border-radius:50%;background:var(--coral);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
  .contact-row{margin-bottom:6px;}
  .skill-bar-item{font-size:12px; margin-bottom:10px;}
  .bar{height:4px; background:var(--line); border-radius:2px; margin-top:4px;}
  .bar span{display:block; height:100%; background:var(--coral); border-radius:2px;}
  .pill{font-size:11px; background:var(--paper3); color:var(--coral-deep); padding:4px 9px; border-radius:20px; display:inline-block; margin:0 5px 5px 0;}
  .c-text{font-size:13.5px; line-height:1.6;}
  .field-textarea{border:1px dashed var(--line); border-radius:6px; background:transparent; font-family:inherit; font-size:13.5px; line-height:1.6; color:inherit; width:100%; padding:8px 10px; resize:vertical; min-height:56px;}
  .field-textarea:focus{outline:none; border-style:solid; border-color:var(--coral-deep);}
  .field-textarea::placeholder{color:#B7BFB2; font-style:italic;}
  .field-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:7px;}
  .reset-btn{font-family:'Space Mono',monospace; font-size:10px; background:none; border:none; color:var(--ink-soft); cursor:pointer; text-decoration:underline; padding:0;}
  .reset-btn:hover{color:var(--coral-deep);}
  .editable-wrap{position:relative;}
  .editable-wrap.locked .field-textarea{filter:blur(5px); user-select:none;}
  .lock-overlay-inline{position:absolute; left:0; right:0; top:24px; bottom:0; display:flex; align-items:center; justify-content:center; text-align:center; font-size:11.5px; font-weight:700; color:var(--ink); background:rgba(255,248,236,0.55); border-radius:6px; padding:8px; line-height:1.4;}
  .check-item{font-size:13px; margin-bottom:8px; display:flex; gap:7px;}
  .footnote{margin-top:auto; padding-top:12px; border-top:1px dashed var(--line); font-size:11px; color:var(--ink-soft);}

  .sheet.dense{display:flex; flex-direction:column; gap:16px; padding:24px 20px;}
  .contacts-row{display:flex; gap:14px; margin-top:8px; flex-wrap:wrap;}
  .contacts-row .field-input{width:auto; min-width:140px;}
  .block{border-top:1px solid var(--line); padding-top:12px;}
  .proj{font-size:13px; margin-bottom:10px;}
  .proj .t{font-weight:700;}
  .proj .d{color:var(--ink-soft); margin-top:2px;}
  .two-col{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .tag{font-size:11px; background:var(--paper1); padding:4px 8px; border-radius:5px; display:inline-block; margin:0 5px 5px 0;}

  .counter{margin-top:0; font-family:'Space Mono',monospace; font-size:12px; color:var(--ink-soft); text-align:center;}
  .cta-lock{margin-top:14px; background:var(--coral); color:#fff; text-align:center; padding:13px; border-radius:8px; font-weight:700; font-size:14px; opacity:0.45; pointer-events:none; transition:opacity .2s ease;}
  .cta-lock.ready{opacity:1; pointer-events:auto; cursor:pointer;}
  .cta-lock small{display:block; font-weight:400; font-size:11px; margin-top:3px; opacity:0.9;}
  .pdf-hint{font-size:10.5px; color:var(--ink-soft); margin-top:8px; line-height:1.4; text-align:center;}

  /* ---------- МОДАЛКА РАЗБЛОКИРОВКИ ---------- */
  .unlock-overlay{position:fixed; inset:0; background:rgba(30,43,34,0.45); z-index:200; display:none; align-items:center; justify-content:center; padding:20px;}
  .unlock-overlay.open{display:flex;}
  .unlock-modal{background:var(--bg); border-radius:14px; max-width:520px; width:100%; max-height:88vh; overflow-y:auto; padding:28px 26px; position:relative; box-shadow:0 30px 60px -20px rgba(0,0,0,0.4);}
  .unlock-close{position:absolute; top:16px; right:16px; background:none; border:none; font-size:18px; color:var(--ink-soft); cursor:pointer;}
  .unlock-eyebrow{font-family:'Space Mono',monospace; font-size:11px; text-transform:uppercase; letter-spacing:.06em; background:var(--ink); color:var(--paper1); padding:5px 11px; border-radius:20px; display:inline-block;}
  .unlock-modal h3{font-family:'Baloo 2',sans-serif; font-size:21px; margin:14px 0 8px;}
  .unlock-sub{font-size:13.5px; color:var(--ink-soft); line-height:1.55; margin:0 0 18px;}
  .unlock-tabs{display:flex; gap:6px; background:var(--paper1); border-radius:10px; padding:4px; margin-bottom:18px;}
  .unlock-tab{flex:1; font-family:'Manrope',sans-serif; font-weight:700; font-size:12.5px; padding:9px 10px; border-radius:8px; border:none; background:transparent; color:var(--ink-soft); cursor:pointer; position:relative;}
  .unlock-tab.active{background:var(--ink); color:#fff;}
  .unlock-tab[data-tooltip]:hover::after{content:attr(data-tooltip); position:absolute; left:50%; top:calc(100% + 8px); transform:translateX(-50%); background:var(--ink); color:#fff; font-family:'Manrope',sans-serif; font-weight:400; font-size:11.5px; line-height:1.4; padding:8px 12px; border-radius:8px; width:220px; z-index:40; box-shadow:0 6px 18px -8px rgba(30,43,34,0.45); text-align:center; pointer-events:none;}
  .unlock-tab[data-tooltip]:hover::before{content:""; position:absolute; left:50%; top:calc(100% + 2px); transform:translateX(-50%); border:6px solid transparent; border-bottom-color:var(--ink); z-index:41; pointer-events:none;}
  .unlock-hint{font-size:13px; color:var(--ink-soft); line-height:1.5; margin:0 0 10px;}
  .post-variants{display:flex; flex-direction:column; gap:8px;}
  .post-variant{background:var(--paper1); border:1px solid var(--line); border-radius:8px; padding:11px 13px;}
  .post-variant .pv-text{font-size:12.5px; line-height:1.5; margin-bottom:8px; white-space:pre-wrap;}
  .pv-copy-btn{font-family:'Space Mono',monospace; font-size:11px; background:var(--paper3); border:1px solid var(--line); border-radius:6px; padding:5px 10px; cursor:pointer;}
  .pv-copy-btn:hover{background:var(--paper2);}
  .pv-actions{display:flex; gap:8px; align-items:center; flex-wrap:wrap;}
  .pv-vk-btn{font-family:'Space Mono',monospace; font-size:11px; background:var(--paper3); border:1px solid var(--line); border-radius:6px; padding:5px 10px; text-decoration:none; color:inherit;}
  .pv-vk-btn:hover{background:var(--paper2);}
  .post-link-input{width:100%; font-family:'Manrope',sans-serif; font-size:13px; padding:10px 12px; border-radius:8px; border:1px solid var(--line); background:var(--white); margin-bottom:10px;}
  .unlock-confirm-btn{width:100%; font-family:'Manrope',sans-serif; font-weight:700; font-size:13.5px; background:var(--coral); color:#fff; border:none; border-radius:8px; padding:12px; cursor:pointer;}
  .unlock-confirm-btn:hover{background:var(--coral-deep);}
  .unlock-confirm-btn:disabled{opacity:0.5; cursor:default;}
  .unlock-note{font-size:12px; color:var(--ink-soft); margin-top:10px; text-align:center; min-height:16px;}
  .unlock-note.success{color:#3D7A3D; font-weight:700;}
  .wait-timer{font-family:'Space Mono',monospace; font-size:38px; font-weight:700; text-align:center; color:var(--coral-deep); margin:18px 0 6px;}
  .unlock-footnote{font-size:11px; color:var(--ink-soft); text-align:center; margin:16px 0 0; padding-top:14px; border-top:1px solid var(--line);}
  .pre-print-steps{display:flex; flex-direction:column; gap:10px; margin:18px 0;}
  .pre-print-step{background:var(--paper1); border:1px solid var(--line); border-radius:8px; padding:12px 14px; font-size:13.5px; text-align:left; line-height:1.4;}

  /* Воздушный пузырь бонуса (комикс-стиль) после разблокировки */
  .bonus-bubble{position:fixed; right:18px; bottom:18px; z-index:300; max-width:min(380px, 92vw); background:var(--bg); border:2px solid var(--ink); border-radius:14px; box-shadow:0 18px 40px -14px rgba(30,43,34,0.45); padding:16px 16px 14px; display:none;}
  .bonus-bubble.open{display:block; animation:popIn .28s ease;}
  @keyframes popIn{from{opacity:0; transform:translateY(14px) scale(.96);} to{opacity:1; transform:translateY(0) scale(1);}}
  .bonus-bubble::before{content:""; position:absolute; top:-13px; right:26px; width:22px; height:22px; background:var(--bg); border-left:2px solid var(--ink); border-top:2px solid var(--ink); transform:rotate(45deg);}
  .bonus-eyebrow{font-family:'Space Mono',monospace; font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--coral-deep); font-weight:700; margin-bottom:5px;}
  .bonus-bubble h4{font-family:'Baloo 2',sans-serif; font-size:16px; margin:0 0 6px;}
  .bonus-bubble p{font-size:12.5px; line-height:1.5; color:var(--ink); margin:0 0 10px;}
  .bonus-prompt{width:100%; font-family:'Manrope',sans-serif; font-size:12px; line-height:1.45; background:var(--paper1); border:1px solid var(--line); border-radius:8px; padding:10px 12px; color:var(--ink); resize:none; min-height:96px; margin-bottom:10px; box-sizing:border-box;}
  .bonus-actions{display:flex; gap:8px; flex-wrap:wrap; align-items:center;}
  .bonus-copy-btn{font-family:'Space Mono',monospace; font-size:11px; background:var(--ink); color:#fff; border:none; border-radius:6px; padding:8px 12px; cursor:pointer; flex:1; min-width:120px;}
  .bonus-copy-btn:hover{background:var(--coral-deep);}
  .bonus-link-btn{font-family:'Space Mono',monospace; font-size:11px; background:var(--paper3); border:1px solid var(--line); border-radius:6px; padding:8px 12px; text-decoration:none; color:inherit;}
  .bonus-link-btn:hover{background:var(--paper2);}
  .bonus-close{position:absolute; top:10px; right:12px; background:none; border:none; font-size:14px; color:var(--ink-soft); cursor:pointer; padding:2px 6px;}

  /* RIGHT */
  .board-pane{padding:32px 28px 60px; position:relative;}
  .board-header{max-width:640px; margin-bottom:18px;}
  .board-header .eyebrow{font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.1em; text-transform:uppercase; background:var(--ink); color:var(--paper1); padding:5px 12px; border-radius:20px; display:inline-block;}
  .board-header h2{font-family:'Baloo 2',sans-serif; font-weight:800; font-size:24px; margin:14px 0 6px;}
  .board-header p{color:var(--ink-soft); font-size:14px; line-height:1.5; margin:0;}

  .mode-switch{display:inline-flex; background:var(--paper1); border:1px solid var(--line); border-radius:999px; padding:4px; margin:18px 0 22px; gap:2px;}
  .mode-btn{font-family:'Manrope',sans-serif; font-weight:700; font-size:13px; padding:9px 18px; border-radius:999px; border:none; background:transparent; color:var(--ink-soft); cursor:pointer; transition:all .15s ease;}
  .mode-btn.active{background:var(--ink); color:#fff;}

  .filters{display:flex; flex-wrap:wrap; gap:8px; margin:0 0 22px;}
  .chip{font-family:'Space Mono',monospace; font-size:12.5px; padding:7px 13px; border-radius:999px; border:2px solid var(--ink); background:var(--paper1); cursor:pointer; user-select:none;}
  .chip.active{background:var(--coral); color:#fff; border-color:var(--coral-deep);}

  .board{display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:18px;}
  .card{background:var(--paper1); border-radius:6px; padding:18px 16px 16px; box-shadow:0 8px 18px -10px rgba(30,43,34,0.3); border:1px solid var(--line); display:flex; flex-direction:column;}
  .card:nth-child(3n+2){background:var(--paper2);}
  .card:nth-child(3n){background:var(--paper3);}
  .card-top{border-radius:5px 5px 0 0; margin:-18px -16px 12px; padding:12px 14px 11px; background:linear-gradient(135deg, rgba(212,100,70,0.12), rgba(212,100,70,0.05)); border-bottom:1px solid rgba(212,100,70,0.22);}
  .card-eyebrow{font-family:'Space Mono',monospace; font-size:12.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--coral-deep); font-weight:700; margin-bottom:6px; display:block;}
  .card-exam{display:flex; flex-wrap:wrap; gap:6px;}
  .card-exam .ex{font-size:12px; font-weight:700; background:#fff; border:1px solid rgba(212,100,70,0.35); border-radius:999px; padding:3px 10px; color:var(--ink);}
  .card h3{font-family:'Baloo 2',sans-serif; font-size:17px; margin:0 0 8px; line-height:1.25;}
  .card h3 a{color:inherit; text-decoration:none;}
  .card h3 a:hover{color:var(--coral-deep);}
  .card-comment{font-size:12.5px; line-height:1.5; color:var(--ink-soft); margin:0 0 12px;}
  .card-roles{font-size:12.5px; line-height:1.45; margin:0 0 12px; color:var(--ink);}
  .card-roles b{font-weight:700; color:var(--coral-deep);}
  .tag-row{display:flex; flex-wrap:wrap; gap:5px; margin-bottom:10px;}
  .skill-tag{font-family:'Space Mono',monospace; font-size:10.5px; padding:3px 8px; border-radius:5px; background:rgba(30,43,34,0.07); color:var(--ink-soft);}
  .roles{font-size:12.5px; margin:0 0 12px; list-style:none; padding:0;}
  .roles li{padding-left:14px; position:relative; margin-bottom:4px;}
  .roles li::before{content:"→"; position:absolute; left:0; color:var(--coral-deep); font-weight:700;}
  .research-toggle{font-family:'Space Mono',monospace; font-size:10.5px; background:none; border:none; color:var(--ink-soft); cursor:pointer; padding:0; text-align:left; margin-bottom:8px; text-decoration:underline;}
  .research-toggle:hover{color:var(--coral-deep);}
  .research-box{display:none; background:var(--paper3); border-radius:6px; padding:10px 11px; margin-bottom:10px; font-size:11.5px; line-height:1.5;}
  .research-box.open{display:block;}
  .research-box .rb-summary{margin-bottom:6px;}
  .research-box .rb-caveat{color:var(--ink-soft); font-style:italic; margin-bottom:6px;}
  .research-box .rb-source{color:var(--coral-deep); font-size:10.5px;}
  .research-box .rb-source a{color:inherit;}
  .add-btn{margin-top:auto; font-family:'Manrope',sans-serif; font-weight:700; font-size:13px; background:var(--ink); color:#fff; border:none; border-radius:6px; padding:9px; cursor:pointer;}
  .add-btn:hover{background:var(--coral-deep);}
  .add-btn.added{background:#7FA37F;}
  .add-btn.added:hover{background:#C0504A;}
  .empty-state{font-size:13.5px; color:var(--ink-soft); padding:20px 0;}

  .role-grid{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:26px;}
  .role-chip{font-family:'Manrope',sans-serif; font-weight:600; font-size:13.5px; padding:11px 16px; border-radius:10px; background:var(--paper3); border:1px solid var(--line); cursor:pointer; transition:all .15s ease;}
  .role-chip:hover{transform:translateY(-1px);}
  .role-chip.active{background:var(--ink); color:#fff;}
  .byrole-hint{font-size:13.5px; color:var(--ink); background:var(--paper3); border:1px solid var(--line); border-left:3px solid var(--coral); border-radius:8px; padding:12px 15px; margin-bottom:14px; line-height:1.5;}
  .role-search{width:100%; max-width:420px; font-family:'Manrope',sans-serif; font-size:13.5px; padding:11px 14px; border-radius:10px; border:1px solid var(--line); background:var(--white); margin-bottom:16px;}
  .role-search:focus{outline:none; border-color:var(--coral-deep);}
  .role-chosen-chip{display:inline-flex; align-items:center; gap:10px; background:var(--ink); color:#fff; font-weight:600; font-size:13.5px; padding:10px 16px; border-radius:10px; margin-bottom:18px;}
  .role-chosen-chip button{background:rgba(255,255,255,0.2); border:none; color:#fff; border-radius:6px; padding:3px 9px; font-size:12px; cursor:pointer; font-family:'Manrope',sans-serif;}
  .role-chosen-chip button:hover{background:rgba(255,255,255,0.35);}
  .skill-check{display:flex; align-items:flex-start; gap:10px; background:var(--paper1); border:1px solid var(--line); border-radius:8px; padding:12px 14px; margin-bottom:10px; cursor:pointer;}
  .skill-check.have{background:#EAF3EA; border-color:#B9D8B9;}
  .skill-check .box{width:18px; height:18px; border-radius:5px; border:2px solid var(--ink-soft); flex-shrink:0; margin-top:1px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700;}
  .skill-check.have .box{background:#4E8B4E; border-color:#4E8B4E; color:#fff;}
  .skill-check .txt .sk{font-weight:700; font-size:13.5px;}
  .skill-check .txt .src{font-size:11.5px; color:var(--ink-soft); margin-top:2px;}

  .chat-wrap{max-width:640px;}
  .chat-log{display:flex; flex-direction:column; gap:12px; margin-bottom:16px; min-height:120px;}
  .msg{max-width:80%; padding:11px 15px; border-radius:14px; font-size:13.5px; line-height:1.5;}
  .msg.bot{background:var(--paper1); border:1px solid var(--line); align-self:flex-start; border-bottom-left-radius:4px;}
  .msg.user{background:var(--ink); color:#fff; align-self:flex-end; border-bottom-right-radius:4px;}
  .chat-input-row{display:flex; gap:8px; margin-bottom:14px;}
  .chat-input-row input{flex:1; font-family:'Manrope',sans-serif; font-size:13.5px; padding:11px 14px; border-radius:10px; border:1px solid var(--line); background:var(--white);}
  .chat-input-row button{font-family:'Manrope',sans-serif; font-weight:700; font-size:13px; background:var(--coral); color:#fff; border:none; border-radius:10px; padding:0 18px; cursor:pointer;}
  .quick-replies{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px;}
  .quick-reply{font-family:'Manrope',sans-serif; font-size:12.5px; background:var(--paper3); border:1px solid var(--line); border-radius:999px; padding:7px 13px; cursor:pointer;}
  .dontknow-btn{font-family:'Manrope',sans-serif; font-size:12.5px; background:none; border:1px dashed var(--ink-soft); color:var(--ink-soft); border-radius:999px; padding:7px 13px; cursor:pointer; margin-bottom:16px;}
  .dontknow-btn:hover{border-color:var(--coral-deep); color:var(--coral-deep);}
  .branch-panel{background:var(--paper3); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:16px;}
  .branch-hint{font-size:12.5px; color:var(--ink-soft); margin-bottom:10px;}
  .branch-chips{display:flex; flex-wrap:wrap; gap:7px;}
