// "на доверии" (см. ветку else ниже), сайт не ломается без задеплоенной функции.
const VERIFY_FUNCTION_URL = ''; // TODO: вставить URL после деплоя

/* ---------- Бонус: воздушный пузырь с промтом для тренировки собеседования ---------- */
const bonusBubble = document.getElementById('bonusBubble');
const bonusPrompt = document.getElementById('bonusPrompt');
const bonusCopyBtn = document.getElementById('bonusCopyBtn');
const bonusClose = document.getElementById('bonusClose');

function buildInterviewPrompt(){
  const role = profile.role || (added[0] && (added[0].roles||[])[0]) || 'начинающий специалист';
  const skillLines = [...new Set(added.flatMap(a=>{
    const s = a.skills_reframed && a.skills_reframed.length ? a.skills_reframed.join('; ') : (a.skills||[]).join('; ');
    return s.split(';').map(x=>x.trim()).filter(Boolean);
  }))].slice(0, 4);
  const skillsText = skillLines.length ? skillLines.join(', ') : 'склонность к обучению и внимательность к деталям';
  return 'Ты — доброжелательный рекрутер. Проводишь собеседование с человеком без опыта работы, который претендует на роль: ' + role + '. Его сильные стороны из резюме: ' + skillsText + '. Задай мне 5 вопросов по одному — начинай с простых (почему хочешь работать, какой график удобен), потом спроси про мои сильные стороны. После каждого моего ответа давай короткую реакцию. В конце разбери мои ответы и дай 3 совета, как отвечать лучше.';
}

function showBonusBubble(){
  const promptText = buildInterviewPrompt();
  bonusPrompt.value = promptText;
  bonusBubble.classList.add('open');
}

function hideBonusBubble(){
  bonusBubble.classList.remove('open');
}
bonusClose.addEventListener('click', hideBonusBubble);
bonusCopyBtn.addEventListener('click', async ()=>{
  const ok = await copyText(bonusPrompt.value);
  bonusCopyBtn.textContent = ok ? '✓ Скопировано' : 'Не вышло — выдели текст вручную';
  if(ok) setTimeout(()=>{ bonusCopyBtn.textContent = '📋 Скопировать промт'; }, 2000);
});

function grantAccessAndPrint(){
  setUnlocked();
  updateResume();
  unlockOverlay.classList.remove('open');
  showBonusBubble();
  showPrePrintInstruction();
}

confirmShareBtn.addEventListener('click', async ()=>{
  const link = postLinkInput.value.trim();
  if(!link){ shareNote.textContent = 'Вставь ссылку на пост, пожалуйста.'; shareNote.className='unlock-note'; return; }
  if(!/^https?:\/\//.test(link)){ shareNote.textContent = 'Похоже, это не похоже на ссылку.'; shareNote.className='unlock-note'; return; }

  if(!VERIFY_FUNCTION_URL){
    console.warn('VERIFY_FUNCTION_URL не настроен — проверка ссылки пропущена (доверительный режим)');
    shareNote.textContent = '✓ Спасибо! Разблокировано.';
    shareNote.className = 'unlock-note success';
    setTimeout(grantAccessAndPrint, 700);
    return;
  }

  confirmShareBtn.disabled = true;
  shareNote.textContent = 'Проверяем...';
  shareNote.className = 'unlock-note';

  try{
    const res = await fetch(VERIFY_FUNCTION_URL, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({link})
    });
    const data = await res.json();
    if(data.verified){
      shareNote.textContent = '✓ Спасибо! Разблокировано.';
      shareNote.className = 'unlock-note success';
      setTimeout(grantAccessAndPrint, 700);
    } else {
      shareNote.textContent = data.reason || 'Не удалось подтвердить пост — проверь ссылку.';
      shareNote.className = 'unlock-note';
      confirmShareBtn.disabled = false;
    }
  } catch(e){
    shareNote.textContent = 'Не получилось проверить (проблема с сетью) — попробуй ещё раз или выбери вкладку "Просто подождать".';
    shareNote.className = 'unlock-note';
    confirmShareBtn.disabled = false;
  }
});

function formatMS(ms){
  const m = Math.floor(ms/60000);
  const s = Math.floor((ms%60000)/1000);
  return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

let waitInterval = null;
function startOrResumeWaitTimer(){
  let startedAt = parseInt(localStorage.getItem(WAIT_START_KEY) || '0', 10);
  if(!startedAt){
    startedAt = Date.now();
    localStorage.setItem(WAIT_START_KEY, String(startedAt));
  }
  if(waitInterval) clearInterval(waitInterval);
  waitInterval = setInterval(()=>{
    const remainingMs = Math.max(0, WAIT_MS - (Date.now() - startedAt));
    waitTimerEl.textContent = formatMS(remainingMs);
    if(remainingMs <= 0){
      clearInterval(waitInterval);
      localStorage.removeItem(WAIT_START_KEY);
      waitTimerEl.textContent = '✓ Готово!';
      waitNoteEl.textContent = 'Открываем...';
      waitNoteEl.className = 'unlock-note success';
      setTimeout(grantAccessAndPrint, 500);
    }
  }, 500);
}

