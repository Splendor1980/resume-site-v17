---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const site = (Astro.site?.href ?? '').replace(/\/$/, '');

const title = 'Собеседование без опыта: что говорить и чего не бояться — приёмы Карнеги, Гоулстона, Гоулмана и Синека';
const description = 'Как вести себя на собеседовании, если нет опыта работы: приёмы Карнеги, Гоулстона, Гоулмана, Синека, Ивановой и других авторов. Не «библия», а то, что можно потренировать уже сегодня — 20 минут репетиции.';

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'ru-RU',
  mainEntityOfPage: site + '/sobesedovanie/',
  author: { '@type': 'Organization', name: 'Резюме без опыта' },
  publisher: { '@type': 'Organization', name: 'Резюме без опыта' },
});
---

<BaseLayout title={title} description={description} ogType="article" structuredData={structuredData}>
  <Header />
  <main id="guideContent">
    <div class="wrap" style="padding-top:8px;">
      <p class="crumbs">
        <a href="/">Главная</a> / Подготовка к собеседованию
      </p>
    </div>

    <section class="idea-hero">
      <span class="eyebrow">лайфхак · без «библии»</span>
      <h1>Собеседование без опыта: что говорить, когда нечем подтвердить стаж</h1>
      <p class="idea-lede">
        Мы не будем обещать «как пройти любое собеседование». Здесь приёмы из книг, которые
        реально работают и на первой встрече — Дейл Карнеги, Марк Гоулстон, Владимир Якуба,
        Дэниел Гоулман, Саймон Синек, Светлана Иванова и ещё несколько карьерных авторов. А в
        конце — главный лайфхак: <b>протестируй себя заранее</b>, это важнее любых подсказок.
      </p>
      <div class="hero-actions" style="margin-top:22px;">
        <button class="cta-btn" id="printPdfBtn" style="background:transparent; border:2px solid var(--ink); color:var(--ink) !important; box-shadow:none;">🖨️ Скачать PDF</button>
        <a class="cta-btn" href="/konstruktor/">Собрать резюме →</a>
      </div>
    </section>

    <div class="idea-body">
      <div class="idea-panel">
        <h2>🧲 Приём Карнеги — «расположи к себе, а не доказывай»</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Дейл Карнеги в <b>«Как завоёвывать друзей и оказывать влияние на людей»</b> (1936) собрал
          простые правила: искренне интересуйся собеседником, помни его имя, говори о том, что
          важно ему, дай ему почувствовать себя значимым. Это не про лесть — это про уважение.
          На собеседовании без опыта у тебя почти нет «фактов», которые можно показать, — и главным
          инструментом становится <b>расположение</b>. Практические приёмы оттуда:
        </p>
        <ul style="margin:12px 0 10px; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Улыбка и имя-отчество.</b> Называй интервьюера по имени и отчеству — это снимает
            формальность и создаёт доверие.</li>
          <li><b>Говори больше о компании, чем о себе.</b> Спрашивай про команду, про то, как
            устроен день, что важнее всего в этой роли. Люди любят рассказывать о своей работе —
            дай им эту возможность, и разговор перестанет быть допросом.</li>
          <li><b>Не спорь.</b> Если сомневаются в твоих знаниях — мягко согласись: «Да, вы правы,
            мне ещё предстоит это изучить, но я быстро учусь». Спор с рекрутером проигрышен в
            любом случае: выигрывает готовность признать пробел и показать, как ты его закрываешь.</li>
        </ul>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Это лучший ответ на главный вопрос такого собеседования — «почему у тебя нет опыта».
        </p>
      </div>

      <div class="idea-panel">
        <h2>👂 Приём Гоулстона — «сначала услышь, потом отвечай»</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Марк Гоулстон, психиатр и автор <b>«Искусства слышать собеседника»</b> (с англ. «Just
          Listen», 2009), настаивает: человек перестаёт защищаться и начинает говорить, когда
          чувствует, что его поняли. Техника простая: не бросайся отвечать, а <b>перескажи вопрос
          своими словами</b> — «То есть вам важно понять, как я принял решение в такой ситуации?».
          Это снимает страх и заученность, и рекрутер видит человека, а не конструкцию. Отсюда же
          три приёма под собеседование без опыта:
        </p>
        <ul style="margin:12px 0 10px; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Сними защиту нанимателя.</b> Он не боится «нет стажа» — он боится взять новичка,
            за которым придётся дорабатывать. Скажи прямо: «Я понимаю, что мне предстоит вникать
            в дело, и готов(а) тратить на это своё время».</li>
          <li><b>Зеркалирование и паузы.</b> Не перебивай, дай высказаться до конца и
            переспрашивай: «Правильно ли я понял, что для вас на этой позиции важнее всего
            дисциплина?».</li>
          <li><b>Признай напряжение.</b> На каверзный или агрессивный вопрос не пугайся: «Вижу,
            этот критерий для вас ключевой» — и только потом отвечай.</li>
        </ul>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          А вопрос «почему у тебя нет опыта» Гоулстон советует не парировать, а сначала назвать
          переживание: «Честно, это мой главный страх на этой встрече» — и только потом переводить
          разговор в плюс.
        </p>
      </div>

      <div class="idea-panel">
        <h2>🤝 Приём Якубы — «собеседование — это диалог, а не экзамен»</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Владимир Якуба — российский спикер и карьерный консультант, автор книг и курсов о
          трудоустройстве. Из его публичных выступлений мы берём одну устойчивую идею: собеседование
          — это деловая встреча двух равных сторон, а не проверка, которую тебе «устраивают».
          Поэтому кандидату положено <b>задавать вопросы</b>: про задачи, про команду, про то, как
          оценивают результат. Мы не приводим точных цитат — здесь важна сама идея, а не отдельная
          фраза. Три упражнения из этого подхода:
        </p>
        <ul style="margin:12px 0 10px; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Проактивность.</b> Не жди вопросов — приноси решения. Приготовь к встрече мини-проект
            или пару идей, что улучшить в работе отдела: это «опыт» в форме, которую нельзя
            переспорить.</li>
          <li><b>Договорённости в конце.</b> Возьми инициативу при прощании: «Каковы наши следующие
            шаги и когда я могу ожидать обратную связь?».</li>
          <li><b>Работа с отказом.</b> Даже если откажут, попроси совета, что именно подтянуть.
            Дверь остаётся открытой, а ответ пригодится на следующем собеседовании.</li>
        </ul>
      </div>

      <div class="idea-panel">
        <h2>🧠 Приём Гоулмана — эмоциональный интеллект вместо академических знаний</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Дэниел Гоулман, автор <b>«Эмоционального интеллекта»</b> (1995), показал: для успеха в
          работе умение ладить с людьми и держать себя в руках влияет не меньше, чем «знания».
          Для новичка это главный козырь — стажа нет, а EQ есть у каждого. Воплощается в двух
          приёмах на собеседовании:
        </p>
        <ul style="margin:12px 0 10px; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Эмпатия к нанимателю.</b> Если интервьюер выглядит уставшим — будь короче и
            дружелюбнее, не перегружай деталями. Это считывается и ценится.</li>
          <li><b>Самообладание.</b> Тебя будут проверять на стресс. Ответ на каверзный вопрос
            <b>с улыбкой и спокойствием</b> ценится выше, чем идеальный, но зазубренный.</li>
        </ul>
      </div>

      <div class="idea-panel">
        <h2>💡 Приём Синека — начни с «зачем»</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Саймон Синек в книге <b>«Start with Why»</b> (2009) и известном выступлении на TED
          показывает: люди вовлекаются не в то, <i>как</i> ты это делаешь, а в то,
          <b><i>зачем</i></b> ты это делаешь. Рекрутер и так знает, что опыта у тебя нет, — а вот
          объяснить, почему ты хочешь развиваться именно в этой сфере и именно в этой компании,
          может только сам кандидат. Чёткая личная мотивация часто побеждает скучающего
          профессионала со стажем.
        </p>
      </div>

      <div class="idea-panel">
        <h2>📐 Метод Ивановой — говори на языке HR</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Светлана Иванова, автор книги <b>«Искусство подбора персонала»</b> и известный российский
          HR-эксперт, применяет в оценке кандидатов <b>метапрограммы</b> — по формулировкам видно,
          что собеседнику важнее. Два паттерна, которые новичку стоит держать в голове:
        </p>
        <ul style="margin:12px 0 10px; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Процесс или результат?</b> Слушай сам вопрос. «Как ты готовил диплом?» — им важен
            процесс. «Чего добился на практике?» — говори цифрами и итогами, не деталями.</li>
          <li><b>Стремление или избегание?</b> Рассказывай не «от чего ушёл» (скучная учёба, плохие
            преподаватели), а <b>к чему стремишься</b>. Позитивная мотивация звучит сильнее.</li>
        </ul>
      </div>

      <div class="idea-panel">
        <h2>🎯 Ещё три фишки: Чалдини, Восс, Батырев</h2>
        <ul style="margin:0; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Роберт Чалдини, «Психология влияния».</b> Принцип социального доказательства:
            показывай, где уже добивался результата в команде — волонтёрство, студенческие
            проекты, курсовые.</li>
          <li><b>Крис Восс, «Никаких компромиссов».</b> Управляющие вопросы на «Как» и «Что»:
            вместо «Я вам подхожу?» спроси «Как вы видите мои первые успехи через месяц работы?».</li>
          <li><b>Максим Батырев, «45 татуировок менеджера».</b> Взрослая позиция: новичку, у
            которого горят глаза, нет страха перед ответственностью и который готов брать задачи,
            отсутствие опыта прощают.</li>
        </ul>
      </div>

      <div class="idea-panel">
        <h2>🧪 Главный лайфхак — протестируй себя на репетиции</h2>
        <p style="margin:0; font-size:14.5px; line-height:1.65;">
          Приёмы выше работают только тогда, когда их уже пробовал. Поэтому вместо чтения
          «100 вопросов и ответов» сделай одно: <b>двадцать минут репетиции</b> до собеседования. Три
          способа — выбери любой:
        </p>
        <ul style="margin:12px 0 0; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Друг или родственник</b> задаёт вопросы из списка ниже, а ты тренируешь приём
            «перескажи вопрос своими словами».</li>
          <li><b>Запись на телефон</b> — отвечай вслух, потом послушай: услышишь, где звучишь
            уверенно, а где нужно иное.</li>
          <li><b>ИИ-чат</b> — в конструкторе после разблокировки PDF мы даём готовый промт:
            скопируй его в Гигачат или Алису, и ИИ сыграет рекрутера. Три вопроса, чтобы начать:
            «Почему хочешь работать именно у нас?», «Какая твоя сильная сторона?», «Где тебе
            ещё не хватает опыта?».</li>
        </ul>
      </div>

      <div class="idea-panel">
        <h2>📇 Кто эти авторы — почему им можно верить</h2>
        <p style="margin:0 0 12px; font-size:14.5px; line-height:1.65;">
          Мы ссылаемся только на людей с понятным профессиональным путём. Вот их ключевые места
          работы и роли, по которым можно проверить компетенцию:
        </p>
        <ul style="margin:0; padding-left:20px; font-size:14.5px; line-height:1.75;">
          <li><b>Дейл Карнеги</b> — основатель международного института Dale Carnegie Training, его
            книга «Как завоёвывать друзей…» — классика делового общения.</li>
          <li><b>Марк Гоулстон</b> — ведущий тренер ФБР по переговорам об освобождении заложников;
            профессор психиатрии UCLA (Калифорнийский университет).</li>
          <li><b>Дэниел Гоулман</b> — ведущий научный журналист The New York Times; психолог, связан
            с Гарвардским университетом (Harvard).</li>
          <li><b>Саймон Синек</b> — работал в Ogilvy &amp; Mather и Euro RSCG (стратегическое
            планирование), внештатный советник RAND Corporation.</li>
          <li><b>Светлана Иванова</b> — директор по персоналу Johnson &amp; Johnson Medical по России
            и СНГ; руководитель и старший партнёр KPG Training Center.</li>
          <li><b>Владимир Якуба</b> — коммерческий директор кадровой компании HPS, сооснователь и
            директор кадрового агентства Tom Hunt.</li>
        </ul>
      </div>

      <div class="research-block">
        <div class="rb-label">🔬 грань честности</div>
        <p style="margin:0 0 6px;">
          Мы опираемся на общеизвестные принципы и книги Карнеги, Гоулстона, Гоулмана, Синека,
          Ивановой, Чалдини, Восса и Батырева. Идеи передаём своими словами, без приписывания
          точных цитат. Должности и компании указаны по публичным данным об авторах. Советы не
          гарантируют «прохождение» собеседования — они помогают говорить спокойнее и понятнее,
          что обычно и решает исход встречи без опыта за плечами.
        </p>
        <div class="rb-source">Источники: Д. Карнеги, «Как завоёвывать друзей...» · М. Гоулстон, «Just Listen» · Д. Гоулман, «Эмоциональный интеллект» · С. Синек, «Start with Why» · С. Иванова, «Искусство подбора персонала» · Р. Чалдини, «Психология влияния» · К. Восс, «Никаких компромиссов» · М. Батырев, «45 татуировок менеджера» · публичные выступления В. Якубы</div>
      </div>

      <div class="idea-cta">
        <p>
          <b>Собери резюме и возьми его на первую репетицию.</b><br />
          Конструктор сделает «О себе» и опыт из твоих хобби — останется потренироваться отвечать.
        </p>
        <a class="cta-btn" href="/konstruktor/">Открыть конструктор →</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  const printBtn = document.getElementById('printPdfBtn');
  if (printBtn) printBtn.addEventListener('click', () => window.print());
</script>

<style is:global>
  @media print {
    .site-header,
    .site-footer,
    .crumbs,
    #printPdfBtn {
      display: none !important;
    }
    #guideContent {
      max-width: 100% !important;
    }
    .idea-hero,
    .idea-body {
      max-width: 100% !important;
      padding: 0 !important;
    }
    .idea-hero {
      padding-bottom: 14px !important;
    }
    .idea-panel {
      break-inside: avoid;
      box-shadow: none !important;
    }
    @page {
      margin: 14mm;
    }
  }
</style>